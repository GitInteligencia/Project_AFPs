# =====================================================================
# Copiar a .env y completar. NO commitear .env.
# Lo usa el sync (main.py + sync/*.py) corriendo en local o on-prem.
# En Cloud Run estos valores llegan por --set-env-vars / --set-secrets
# (ver .github/workflows/deploy-sync.yml); el .env no viaja en la imagen.
# =====================================================================

# --- SQL Server fuente (red Patria; ODBC Driver 18) ---
DB_SERVER=
DB_DATABASE=Inteligencia_Mercado
DB_UID=
DB_PWD=

# --- Destino BigQuery (credenciales por ADC: gcloud auth application-default login) ---
GCP_PROJECT_ID=pat-uat-global
BQ_LOCATION=southamerica-west1
BQ_DATASET_RAW=afp_raw
BQ_DATASET_DIM=afp_dim
BQ_DATASET_MART=afp_mart
BQ_DATASET_OPS=afp_ops
BQ_DATASET_STG=afp_stg

# --- Revalidación de la web al terminar la corrida (opcional en local) ---
# URL *.run.app del servicio afp-web y el token del secreto afp-web-revalidate-token.
# Vacíos = el job omite el POST /api/revalidate.
WEB_URL=
REVALIDATE_TOKEN=

# =====================================================================
# LEGACY (hasta el corte a GCP): destino Supabase del flujo laptop + Vercel.
# Se elimina en F6 del PLAN_MIGRACION_GCP.md.
# =====================================================================
# REST API path — works behind corporate firewalls that block Postgres ports
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (used by web/ client-side auth)
SUPABASE_ANON_KEY=
# Optional: direct Postgres (only usable from networks without firewall)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
