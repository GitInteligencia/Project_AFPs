# Copy to .env.local and fill in real values. Do NOT commit .env.local.
# GCP access uses Application Default Credentials (no key files):
#   local:     gcloud auth application-default login
#   Cloud Run: the service's runtime service account

# --- BigQuery (data) ---------------------------------------------------------
GCP_PROJECT_ID=pat-uat-global
BQ_LOCATION=southamerica-west1
BQ_DATASET_RAW=afp_raw
BQ_DATASET_DIM=afp_dim
BQ_DATASET_MART=afp_mart

# --- Identity Platform (auth) -----------------------------------------------
# Web API key of the Identity Platform project (public; restrict it to the
# Identity Toolkit API in the console).
NEXT_PUBLIC_IDP_API_KEY=
# Lifetime of the __session cookie in hours (5 min .. 14 days). Default 12.
IDP_SESSION_HOURS=12

# --- Cache invalidation ------------------------------------------------------
# Shared secret the sync job sends in `x-revalidate-token` to POST /api/revalidate.
REVALIDATE_TOKEN=
